FROM quay.io/centos-bootc/centos-bootc:stream10

# 1. Create the mdatp service account before the package is installed.
#    The package's %pre scriptlet is supposed to do this with useradd, but it
#    does not happen in a container build, and a missing mdatp user cascades
#    into the installer relocating its log directory into the read-only
#    install tree. sysusers.d also re-asserts the account on every boot.
COPY files/mdatp.sysusers.conf /usr/lib/sysusers.d/mdatp.conf
RUN systemd-sysusers && id mdatp

# 2. Install the agent from Microsoft's RHEL 10 repository.
#    The %post scriptlet exits 1 because it tries to talk to systemd and to
#    start the daemon, neither of which exists during a build. dnf still
#    returns 0 and the payload is complete; steps 3 to 8 do the parts of
#    %post that matter and that a build can actually do.
RUN rpm --import https://packages.microsoft.com/keys/microsoft-2025.asc && \
    curl -fsSL -o /etc/yum.repos.d/microsoft-prod.repo \
      https://packages.microsoft.com/config/rhel/10/prod.repo && \
    dnf -y install mdatp && \
    test -x /opt/microsoft/mdatp/sbin/wdavdaemon && \
    dnf clean all

# 3. Install the SELinux policy modules the package ships. %post skips this
#    in a build because sestatus reports SELinux as not enabled there.
RUN semodule -i /opt/microsoft/mdatp/conf/selinux_policies/out/mdatp_service.pp && \
    semodule -i /opt/microsoft/mdatp/conf/selinux_policies/out/audisp_mdatp_rhel77.pp && \
    semodule -l | grep -q mdatp_service

# 4. Recreate the writable state and log directories on every boot. Content
#    placed in /var by the image is applied at install time only, so a
#    tmpfiles.d entry is what keeps these present across upgrades.
COPY files/mdatp.tmpfiles.conf /usr/lib/tmpfiles.d/mdatp.conf

# 5. Seed the antimalware definitions into /var before the daemon starts,
#    which is what the package's %post does on a conventional host. This is
#    a unit rather than a build step because /var content baked into the
#    image is applied at install time only and would not reappear after an
#    upgrade that changed the shipped engine.
COPY files/mdatp-seed-definitions /usr/libexec/mdatp-seed-definitions
COPY files/mdatp-seed-definitions.service /usr/lib/systemd/system/mdatp-seed-definitions.service
RUN chmod 0755 /usr/libexec/mdatp-seed-definitions

# 6. ONBOARDING PLACEHOLDER. Replace the RUN below with a COPY of the
#    mdatp_onboard.json extracted from your tenant's
#    WindowsDefenderATPOnboardingPackage.zip. It is tenant-specific, so the
#    image that carries it is tenant-specific too. Per Microsoft's golden
#    image guidance the file must be placed while the service is not running,
#    which a container build satisfies by construction: nothing starts here,
#    so no device identity is captured into the image.
#
#    COPY mdatp_onboard.json /etc/opt/microsoft/mdatp/mdatp_onboard.json
RUN install -d -m 0755 /etc/opt/microsoft/mdatp /etc/opt/microsoft/mdatp/managed && \
    echo "PLACEHOLDER: copy tenant mdatp_onboard.json to /etc/opt/microsoft/mdatp/" \
      > /etc/opt/microsoft/mdatp/ONBOARDING-REQUIRED.txt

# 7. The mdatp CLI symlink is created by %post, which does not get that far.
#    Microsoft documents this exact symlink as the fix when `mdatp` is not
#    found on PATH.
RUN ln -sf /opt/microsoft/mdatp/sbin/wdavdaemonclient /usr/bin/mdatp

# 8. Enable the units. mdatp.service is installed into
#    /usr/lib/systemd/system by the package's %post, which does run far
#    enough to copy it.
RUN systemctl enable mdatp.service && \
    systemctl enable mdatp-seed-definitions.service && \
    systemctl enable mde_netfilter_v2.socket

# 9. Defender reads the hostname when the service starts and keeps reporting
#    under whatever it saw. On a cloned host the final hostname is often set
#    by cloud-init at first boot, so order the service after it.
COPY files/10-hostname-stable.conf /usr/lib/systemd/system/mdatp.service.d/10-hostname-stable.conf

RUN bootc container lint
